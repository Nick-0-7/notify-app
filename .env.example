# Supabase Configuration
# Obtain these from your Supabase project dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Direct Connection (for migrations & worker direct queries if preferred)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Firebase Cloud Messaging
# Download service account JSON from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_CREDENTIALS_JSON_PATH=./service-account.json
# Or inline JSON string in CI/Worker
FIREBASE_SERVICE_ACCOUNT_JSON=

# Worker Settings
WORKER_LOG_LEVEL=INFO
WORKER_INTERVAL_MINUTES=15
WORKER_MAX_CONCURRENT_REQUESTS=5
WORKER_USER_AGENT=NotifyBot/1.0 (+https://github.com/your-org/notify; contact: admin@notify-app.internal)
WORKER_REQUEST_TIMEOUT_SECONDS=15
WORKER_MAX_REDIRECTS=3
WORKER_MAX_RESPONSE_BYTES=10485760
